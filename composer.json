{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "ext-pdo": "*",
        "babenkoivan/elastic-scout-driver": "^4.0",
        "cviebrock/eloquent-sluggable": "^12.0",
        "darkaonline/l5-swagger": "^8.6",
        "http-interop/http-factory-guzzle": "^1.2",
        "intervention/image-laravel": "^1.3",
        "jagarsoft/laravel-tactician": "^1.0",
        "james-heinrich/getid3": "^1.9",
        "jeroen-g/explorer": "^4.1",
        "kalnoy/nestedset": "^6.0",
        "laravel/framework": "^12.10.2",
        "laravel/horizon": "^5.31",
        "laravel/octane": "^2.9",
        "laravel/pulse": "^1.4",
        "laravel/reverb": "^1.0",
        "laravel/scout": "^10.14",
        "laravel/telescope": "^5.7",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.29",
        "mews/purifier": "^3.4",
        "mongodb/laravel-mongodb": "^5.1",
        "pion/laravel-chunk-upload": "^1.5",
        "predis/predis": "^2.3",
        "prettus/l5-repository": "^2.9",
        "ramsey/uuid": "^4.7",
        "spatie/fork": "^1.2",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-medialibrary": "^11.11",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-query-builder": "^6.3",
        "staudenmeir/eloquent-has-many-deep": "^1.20",
        "symfony/http-client": "^7.2",
        "symfony/mailgun-mailer": "^7.2",
        "touhidurabir/laravel-model-sanitize": "^1.1",
        "tymon/jwt-auth": "^2.1",
        "zircote/swagger-php": "^4.11"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "barryvdh/laravel-ide-helper": "^3.5",
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.23",
        "laravel/dusk": "^8.3",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Global/AppHelper.php",
            "app/Helpers/Global/TimeZone.php",
            "app/Helpers/Global/CollectionHelper.php",
            "app/Helpers/Global/PaginationHelper.php",
            "app/Helpers/Redis/RedisHelper.php",
            "app/Helpers/Storage/StorageHelper.php",
            "app/Helpers/Global/RelationshipHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/Global/AppHelper.php",
            "app/Helpers/Global/TimeZone.php",
            "app/Helpers/Global/CollectionHelper.php",
            "app/Helpers/Global/PaginationHelper.php",
            "app/Helpers/Redis/RedisHelper.php",
            "app/Helpers/Storage/StorageHelper.php",
            "app/Helpers/Global/RelationshipHelper.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
